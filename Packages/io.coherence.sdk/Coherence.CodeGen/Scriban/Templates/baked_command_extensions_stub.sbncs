#if UNITY_EDITOR || COHERENCE_COMMAND_EXTENSIONS_STUBS_IN_BUILD
[UnityEngine.Scripting.Preserve]
public static class {{ class_name }}
{
{{~ seen_methods = []
for command in commands
    method_name = command.method_name | string.split "." | array.last
    if array.contains seen_methods method_name; continue; end
    seen_methods = array.add seen_methods method_name
    ext_declaring_class = command.extension_method_declaring_class ?? command.method_declaring_class
    type_params = command.extension_method_type_params
    type_params_str = ((array.size type_params) > 0) ? "<" + (type_params | array.join ", ") + ">" : "" ~}}
#if !COHERENCE_COMMAND_EXTENSIONS_STUBS_DONT_OBSOLETE
    [System.Obsolete("This is a generated stub. Bake and use a matching generated extension for your method.")]
#endif
    public static bool {{ method_name }}{{ type_params_str }}(this {{ ext_declaring_class }} self, MessageTarget target, params object[] args) => false;
{{~ end ~}}
}
#endif
