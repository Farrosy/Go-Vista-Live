        public override void SendInputState()
        {
            if (!coherenceInput.IsProducer || !coherenceInput.IsReadyToProcessInputs || !coherenceInput.IsInputOwner)
            {
                return;
            }

            var currentFrame = currentSimulationFrame;

            if (lastAddedFrame != currentFrame)
            {
                var input = currentInput.Clone(client.SchemaDataFactory);
                input.Frame = currentFrame;
                inputBuffer.AddInput(input, currentFrame);
                lastAddedFrame = currentFrame;
            }

            while (inputBuffer.DequeueForSending(currentFrame, out long frameToSend, out InputData input, out bool differs))
            {
                if (!input.IsInitialized) 
                {
                    input = client.SchemaDataFactory.CreateInput({{ inputDefinition.id }}, entityId, MessageTarget.StateAuthorityOnly, 0);
                }
                else
                {
                    input = input.Clone(client.SchemaDataFactory);
                }

                coherenceInput.DebugOnInputSent(frameToSend, input);
                input.Frame = frameToSend;
                input.Entity = entityId;
                client.SendInput(input);
            }
        }
        
        private bool ShouldPollCurrentInput(long frame)
        {
            return coherenceInput.IsProducer && coherenceInput.Delay == 0 && frame == currentSimulationFrame;
        }
        
        private bool GetButton(string name, long? simulationFrame)
        {
            long frame = simulationFrame.GetValueOrDefault(currentSimulationFrame);
            inputBuffer.TryGetInput(frame, out InputData input);
            
            switch (name)
            {
    {{~ for member in inputDefinition.members ~}}
        {{~ if member.type == "Bool" ~}}
                case "{{ member.name }}":
                    if (ShouldPollCurrentInput(frame))
                    {
                        return currentInput.GetField({{ for.index }}).GetBool();
                    }
                    return input.IsInitialized ? input.GetField({{ for.index }}).GetBool() : default;
        {{~ end ~}}
    {{~ end ~}}        
                default:
                    logger.Error(Coherence.Log.Error.ToolkitInputMissingInput, $"No input button of name: {name}.");
                    break;
            }
            
            return default;
        }
        
