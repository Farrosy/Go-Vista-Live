{{~ for component in entityData.components ~}}
	{{~ if component.bake_conditional != "" ~}}
#if {{ component.bake_conditional }}
	{{~ end ~}}
    {{~ for member in component.members_info ~}}
    {{~ cSharpType = resolveCsharpType member.binding_class_name member.property_csharp_type ~}}
    {{~ schemaTypeToCsharpType = resolveSchemaTypeToCsharpType member.schema_type ~}}
    {{~ cSharpTypeToSchemaType = resolveCsharpTypeToSchemaType member.schema_type ~}}
    [UnityEngine.Scripting.Preserve, System.Serializable]
    public class Binding_{{ entityData.asset_id }}_{{ member.binding_guid | string.replace "-" "_" }} : {{ member.binding_class_name }}
    {   
        private global::{{ component.unity_component_type }} CastedUnityComponent;

        protected override void OnBindingCloned()
        {
    	    CastedUnityComponent = (global::{{component.unity_component_type }})UnityComponent;
        }

        public override uint CoherenceComponentID => {{ component.component_id }};
        public override int FieldIndex => {{ member.field_index }};

        public override {{ cSharpType }} Value
        {
            get { {{ member.property_getter }}; }
            set { {{ member.property_setter }}; }
        }

        protected override ({{ cSharpType }} value, AbsoluteSimulationFrame simFrame) ReadComponentData(ComponentData coherenceComponent, Vector3 floatingOriginDelta)
        {
            var field = coherenceComponent.GetField({{ member.field_index }});
            
            var value = field.Get{{ member.schema_type }}(){{ schemaTypeToCsharpType }};
        {{~ if member.binding_class_name == "PositionBinding" ~}}
            if (!coherenceSync.HasParentWithCoherenceSync) { value += floatingOriginDelta; }
        {{~ end ~}}

        {{~ if member.has_sim_frames ~}}
            var simFrame = field.GetSimFrame();
        {{~ else ~}}
            var simFrame = (AbsoluteSimulationFrame)0;
        {{~ end ~}}
            
            return (value, simFrame);
        }

        public override void WriteComponentData(ComponentData coherenceComponent, AbsoluteSimulationFrame simFrame)
        {
            var field = coherenceComponent.GetField({{ member.field_index }});

            if (Interpolator.IsInterpolationNone || SyncMode == SyncMode.Manual)
            {
                field.Set{{ member.schema_type }}(Value{{ cSharpTypeToSchemaType }});
            }
            else
            {
                field.Set{{ member.schema_type }}(GetInterpolatedAt(simFrame / InterpolationSettings.SimulationFramesPerSecond){{ cSharpTypeToSchemaType }});
            }

        {{~ if member.has_sim_frames ~}}
            field.SetSimFrame(simFrame);
        {{~ end ~}}
        } 
    }
    {{~ end ~}}
	{{~ if component.bake_conditional != "" ~}}
#endif // {{ component.bake_conditional }}
	{{~ end ~}}
{{~ end ~}} 