  m_Script: {fileID: 11500000, guid: 3593cca96b18f97429dbaabf5f45b732, type: 3}
  m_Name: tour-intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Vio
  portrait: {fileID: 0}
  dialogueId: tour-intro
  lines:
  - speaker: Vio
    text: Halo! Selamat datang di Go Vista! Aku Vio.
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options: []
  - speaker: Vira
    text: Dan aku Vira! Kamu sekarang ada di Central Plaza, tempat kamu muncul setiap kali masuk Go Vista.
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options: []
  - speaker: Vio
    text: Kota ini punya banyak gedung keren. Mau kami ajak keliling?
    portraitOverride: {fileID: 0}
    isQuestion: 1
    question:
      questionId: tour
      options:
      - optionId: yes
        text: Ayo!
        isCorrect: 1
        reply:
        - speaker: Vira
          text: Yeay! Ikuti cahaya di gedung tujuan, nanti kami tunggu di sana!
          portraitOverride: {fileID: 0}
        askAgainLater: 0
      - optionId: later
        text: Nanti saja
        isCorrect: 0
        reply:
        - speaker: Vio
          text: Oke! Kalau berubah pikiran, sapa kami lagi di sini, ya!
          portraitOverride: {fileID: 0}
        askAgainLater: 1
  charactersPerSecond: 38
  punctuationPause: 0.12
