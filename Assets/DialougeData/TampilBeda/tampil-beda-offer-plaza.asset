  speakerName: Vio
  portrait: {fileID: 0}
  dialogueId: tampil-beda-offer-plaza
  lines:
  - speaker: Vira
    text: Hai lagi! Sudah sempat mampir ke Clothing Shop?
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options: []
  - speaker: Vio
    text: Mira bisa bantu kamu ganti gaya. Mau ke sana sekarang?
    portraitOverride: {fileID: 0}
    isQuestion: 1
    question:
      questionId: tampil-beda
      options:
      - optionId: yes
        text: Ayo!
        isCorrect: 1
        reply:
        - speaker: Vira
          text: Mantap! Tokonya sudah kami tandai di peta.
          portraitOverride: {fileID: 0}
        askAgainLater: 0
      - optionId: later
        text: Nanti saja
        isCorrect: 0
        reply:
        - speaker: Vio
          text: Siap, kapan-kapan saja. Kami tunggu di sini!
          portraitOverride: {fileID: 0}
        askAgainLater: 1
