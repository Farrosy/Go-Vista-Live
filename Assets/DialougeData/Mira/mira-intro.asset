--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3593cca96b18f97429dbaabf5f45b732, type: 3}
  m_Name: mira-intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Mira
  portrait: {fileID: 0}
  dialogueId: mira_intro
  lines:
  - speaker: 
    text: Eh, ada pengunjung baru! Halo, aku <b>Mira</b>, kasir sekaligus stylist di sini. Selamat datang di toko baju Go Vista!
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options:
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
  - speaker: 
    text: Di sini kamu bisa coba macam-macam outfit dan cari gaya yang paling cocok buat kamu!
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options:
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
  - speaker: 
    text: 'Caranya gampang: masuk ke <b>ruang ganti yang tirainya terbuka</b>, lalu berdiri di <b>lingkaran cahaya</b> dan tekan tombol interaksi.'
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options:
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
  - speaker: 
    text: Nanti ada tab <b>Atasan, Bawahan, Kaki, Dalaman, Aksesori</b>, dan <b>Wajah</b>. Geser karakternya buat diputar, terus zoom kalau mau lihat wajah lebih dekat.
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options:
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
  - speaker: 
    text: Kalau sudah cocok, tekan <b>SIMPAN</b>. Oh iya, rambut diganti di <b>barbershop</b>, kalau kulit dan bentuk kepala di <b>lobby</b>, ya.
    portraitOverride: {fileID: 0}
    isQuestion: 0
    question:
      questionId: 
      options:
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
      - optionId: 
        text: 
        isCorrect: 0
        reply: []
        askAgainLater: 0
  - speaker: 
    text: Udah paham?
    portraitOverride: {fileID: 0}
    isQuestion: 1
    question:
      questionId: paham
      options:
      - optionId: a
        text: Siap, Kak!
        isCorrect: 1
        reply:
        - speaker: 
          text: Mantap! Selamat bergaya, ya. Kalau butuh apa-apa, panggil aku di kasir!
          portraitOverride: {fileID: 0}
        askAgainLater: 0
      - optionId: b
        text: Ulangi dong
        isCorrect: 1
        reply:
        - speaker: 
          text: Boleh banget! Aku jelasin sekali lagi, ya.
          portraitOverride: {fileID: 0}
        - speaker: 
          text: 'Caranya gampang: masuk ke <b>ruang ganti yang tirainya terbuka</b>, lalu berdiri di <b>lingkaran cahaya</b> dan tekan tombol interaksi.'
          portraitOverride: {fileID: 0}
        - speaker: 
          text: Nanti ada tab <b>Atasan, Bawahan, Kaki, Dalaman, Aksesori</b>, dan <b>Wajah</b>. Geser karakternya buat diputar, terus zoom kalau mau lihat wajah lebih dekat.
          portraitOverride: {fileID: 0}
        - speaker: 
          text: Kalau sudah cocok, tekan <b>SIMPAN</b>. Oh iya, rambut diganti di <b>barbershop</b>, kalau kulit dan bentuk kepala di <b>lobby</b>, ya.
          portraitOverride: {fileID: 0}
        - speaker: 
          text: Udah kebayang, kan? Selamat bergaya!
          portraitOverride: {fileID: 0}
        askAgainLater: 0
  charactersPerSecond: 30
  punctuationPause: 0.15
  voiceClips:
  - {fileID: 8300000, guid: eb06d9483b9b50d4d9fdadc4a550d52e, type: 3}
